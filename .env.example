# GitHub Token (bắt buộc)
GITHUB_TOKEN=ghp_your_github_token_here

# LLM Local Endpoint (mặc định: http://localhost:20128/v1)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:14b

# Repository để tạo GitHub Issues (tùy chọn)
DIGEST_REPO=thanhtantran/agents-radar

# Telegram Notifications (tùy chọn - xem docs/TELEGRAM-SETUP.md)
# Lấy Bot Token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Lấy Chat ID từ @userinfobot hoặc API getUpdates
TELEGRAM_CHAT_ID=123456789

# GitHub Pages URL (tùy chọn, mặc định: https://thanhtantran.github.io/agents-radar)
PAGES_URL=https://thanhtantran.github.io/agents-radar
